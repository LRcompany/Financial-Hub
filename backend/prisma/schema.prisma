// Schema inicial — mapeado a partir de docs/blueprint.md
// SQLite não suporta enum nativo no Prisma, então campos que seriam enum
// viram String com o conjunto de valores válidos documentado no comentário.
// Validação desses valores fica na camada de aplicação (ex: Zod), não no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Módulo 1: Financeiro Pessoal ----------

model Transaction {
  id            String   @id @default(uuid())
  date          DateTime
  type          String // income | expense
  description   String
  amount        Float
  source        String   @default("manual") // manual | pluggy | ofx_import
  externalId    String?  @unique // id da transação na Pluggy/OFX, evita duplicar import (upsert)
  isTransfer    Boolean  @default(false) // true = não conta como gasto/receita real
  // true = a Pluggy reportou como "PENDING" (comum em compra internacional —
  // entra com descrição genérica tipo "MASTERCARD INTERNACIONAL" antes do
  // banco confirmar o lojista real). Enquanto true, o próximo sync confere
  // se já virou "POSTED" e atualiza descrição/valor/categoria pro dado real
  // — sem isso, uma transação pendente ficava presa com o nome genérico pra
  // sempre (nosso sync nunca revisita uma já sincronizada). Nunca mexe numa
  // transação já `false` (poderia sobrescrever categoria corrigida à mão).
  pluggyPending Boolean  @default(false)

  // true só pra lançamento MANUAL feito contra um banco/cartão que TEM sync
  // automático da Pluggy (ideia do Luiz, 06/09: lançar a compra assim que
  // acontece, com valor "virtual" já contando no orçamento, em vez de
  // esperar os dias de atraso da Pluggy). O sync de cartão
  // (pluggyTransactionSync.ts) tenta casar a transação real que chegar
  // depois (mesmo broker + valor + data próxima) com essa aqui — quando
  // acha, ATUALIZA em vez de criar linha nova (evita contar a compra 2x) e
  // vira false. Nunca true pra corretora manual de verdade (Wise, Nomad):
  // essas não têm o que confirmar depois.
  awaitingPluggyMatch Boolean @default(false)

  // Compra parcelada (creditCardMetadata da Pluggy) — pedido do Luiz (08/09:
  // "deixa marcado que é uma compra parcelada"). `installmentNumber` é a
  // parcela desta transação especificamente (a que já aconteceu de fato);
  // as parcelas SEGUINTES da mesma compra são UpcomingInstallment, não
  // Transaction. Null pra compra à vista (nunca foi parcelada) ou pra
  // transação sincronizada antes desse campo existir (ver script de
  // backfill de 08/09 — preenchido a partir da cadeia de UpcomingInstallment
  // já projetada quando dava pra derivar).
  installmentNumber Int?
  totalInstallments Int?

  // Compra parcelada a que essa parcela pertence (05/11) — categoria e nota
  // moram na compra, ver model Purchase.
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  // Nome real do comerciante às vezes vem ilegível/genérico da Pluggy (ex:
  // "MASTERCARD", "Parcela de compra lojista MasterCard" — confirmado ao
  // vivo, 08/09: esse tipo de financiamento "lojista" não manda nem
  // comerciante nem installmentNumber/totalInstallments, então nem dá pra
  // marcar como parcelada automaticamente) — `note` é o detalhe que o Luiz
  // mesmo escreve ("Adidas") pra lembrar o que a compra foi de verdade.
  // Mesmo campo/mesma ideia do UpcomingInstallment.note, só que pra uma
  // compra que já aconteceu. Nunca sobrescreve `description` (que continua
  // batendo com a fatura real). Puramente documental — não afeta categoria,
  // valor nem nenhum cálculo.
  note String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Boleto/fatura real que na verdade cobre MAIS de uma categoria (ex:
  // aluguel+água+gás+internet+seguro cobrados juntos num débito só do
  // banco, 14/09) — ver TransactionSplit abaixo. Quando existe pelo menos
  // 1 split, `categoryId` acima deixa de valer pro cálculo de orçamento
  // (cada split soma na SUA categoria); a Transaction em si continua
  // com `amount` intacto, sempre batendo com o extrato/fatura real.
  splits TransactionSplit[]

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id])

  taxPaymentId String?
  taxPayment   TaxPayment? @relation(fields: [taxPaymentId], references: [id])

  projectReceiptId String?
  projectReceipt   ProjectReceipt? @relation(fields: [projectReceiptId], references: [id])

  supplierPaymentId String?
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])

  loanReceivableId String?
  loanReceivable   LoanReceivable? @relation(fields: [loanReceivableId], references: [id])

  createdAt DateTime @default(now())

  @@index([date])
  @@index([categoryId])
  // Última alteração (25/11, conector MCP: "todo número mostra a origem e a data da última alteração").
  updatedAt DateTime? @updatedAt
}

// Divide uma Transaction real (boleto/fatura que junta mais de uma
// categoria — aluguel+água+gás+internet+seguro cobrados num débito só do
// banco, por exemplo) em N pedaços, cada um com sua própria categoria e
// valor. A soma dos splits sempre bate com `Transaction.amount` (validado
// na rota, nunca imposto pelo schema). A Transaction em si nunca muda de
// valor — continua reconciliando com o extrato/fatura real; só o cálculo
// de "gasto por categoria" (budget.ts) passa a somar cada split na
// categoria dele em vez do total inteiro na categoria única da Transaction
// (14/09, pedido do Luiz: "o boleto do aluguel vem com água, gás, internet
// e seguro juntos, como resolver isso?").
model TransactionSplit {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  amount        Float
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([categoryId])
}

// Parcela de compra parcelada que ainda vai vencer — não é Transaction (não
// aconteceu de fato ainda, "nada de valor fake"), mas é informação real
// (vem do próprio livro-razão dele, que já projeta parcela futura). Serve
// pra responder "quanto ainda tenho comprometido no cartão".
model UpcomingInstallment {
  id                String   @id @default(uuid())
  dueDate           DateTime
  description       String
  // Nome real do comerciante geralmente vem ilegível da fatura (ex:
  // "AMAZONMKTPLC HEIMONLTD") — `note` é o detalhe que o Luiz mesmo escreve
  // ("fone de ouvido bluetooth") pra lembrar o que a compra foi de verdade.
  // Nunca sobrescreve `description` (que continua batendo com a fatura real).
  note              String?
  amount            Float
  // Qual cartão/fatura essa parcela pertence (ex: "Caixa 5709", "C6", "BTG")
  // — null pra parcela que veio da planilha sem essa informação (não dava
  // pra saber o cartão só pelo livro-razão). Permite sintetizar "quanto
  // ainda falta em cada cartão", não só o total geral.
  cardLabel         String?
  // "pluggy:<id da transação>:<parcela N>" pra parcela que veio do sync real
  // da Pluggy — evita recriar a mesma parcela futura toda vez que o sync
  // roda de novo. Null pra parcela importada da planilha (sem esse conceito).
  externalId        String?  @unique
  // Total de parcelas da compra (ex: 10 numa compra parcelada em 10x) —
  // override MANUAL (Luiz corrige na modal "Revisar parcelas"). Pra parcela
  // vinda do sync real da Pluggy, dá pra DERIVAR isso sem esse campo (maior
  // N visto no externalId "pluggy:<txId>:<N>" entre as parcelas da mesma
  // compra), então esse campo normalmente fica null e o cálculo automático
  // já resolve. Só é preenchido quando o automático erra ou quando a parcela
  // é da planilha antiga (sem externalId, sem como derivar nada sozinho).
  totalInstallments Int?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id])

  createdAt DateTime @default(now())

  @@index([dueDate])
  // Última alteração (25/11, conector MCP: "todo número mostra a origem e a data da última alteração").
  updatedAt DateTime? @updatedAt
}

model Recurrence {
  id           String   @id @default(uuid())
  frequency    String   @default("monthly") // monthly (único usado hoje)
  installments Int? // número fixo de parcelas, null = recorrente sem fim
  startDate    DateTime

  transactions Transaction[]
  projects     Project[]
}

model Category {
  id                 String  @id @default(uuid())
  name               String
  type               String // income | expense
  // Só relevante pra expense — 3 estados reais (não dava pra fazer isso com
  // um booleano "essential" só): essential | non_essential | investment.
  // "investment" é a seção separada da planilha do Luiz (Reserva de
  // Emergência, Nomad, Ações...) — não é "gasto" no sentido normal, então
  // nunca deveria ter ficado misturada com Streaming/Cinema em "não
  // essencial" (era exatamente isso que a coluna essential=false fazia).
  kind               String  @default("non_essential")
  // Conta pra meta diária de gasto (20/11, Luiz: "aluguel, contas e usina
  // ficam de fora"). Vale pra árvore: categoria fora tira as filhas junto.
  countsForDailyGoal Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  transactions         Transaction[]
  budgetTargets        BudgetTarget[]
  categorizationRules  CategorizationRule[]
  upcomingInstallments UpcomingInstallment[]
  transactionSplits    TransactionSplit[]
  purchases            Purchase[]

  @@unique([name, parentId])
}

model BudgetTarget {
  id            String   @id @default(uuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  month         Int
  year          Int
  plannedAmount Float

  @@unique([categoryId, month, year])
}

// Append-only: cada mudança cria uma linha nova, nunca sobrescreve a
// anterior — "qual era a meta vigente no dia X" é sempre uma consulta
// (maior effectiveFrom <= X), nunca um valor único perdido no tempo.
model DailySpendGoal {
  id            String   @id @default(uuid())
  amount        Float
  effectiveFrom DateTime
}

model Debt {
  id                String            @id @default(uuid())
  creditor          String
  installmentAmount Float
  installmentCount  Int
  startDate         DateTime
  installments      DebtInstallment[]
}

model DebtInstallment {
  id         String   @id @default(uuid())
  debtId     String
  debt       Debt     @relation(fields: [debtId], references: [id])
  dueDate    DateTime
  paid       Boolean  @default(false)
  paidAmount Float?
}

model LoanReceivable {
  id              String                    @id @default(uuid())
  borrower        String
  principalAmount Float
  loanDate        DateTime
  repayments      LoanReceivableRepayment[]
  transactions    Transaction[]
}

model LoanReceivableRepayment {
  id               String         @id @default(uuid())
  loanReceivableId String
  loanReceivable   LoanReceivable @relation(fields: [loanReceivableId], references: [id])
  amount           Float
  paymentDate      DateTime
}

model Broker {
  id                String    @id @default(uuid())
  name              String    @unique // BTG, C6, Caixa, 99, Phantom, Nomad, Mercado Pago, Sofisa, Wise, INCO
  scope             String // JSON array: ["transactions","credit_card","investments"]
  dataSource        String // pluggy | manual_statement | onchain_query
  pluggyConnectorId String?
  onchainAddress    String?
  // Rede da carteira on-chain (dataSource = "onchain_query"): solana | bitcoin
  // | ethereum | base. Endereço EVM (ethereum/base) é o mesmo formato pras
  // duas redes, mas saldo/token são consultados em cada rede separadamente
  // — por isso é 1 Broker por rede, mesmo repetindo o onchainAddress.
  chain             String?
  lastSyncedAt      DateTime?
  // true pra corretora que deve virar sua própria box em Patrimônio, em vez
  // de espalhar as posições por tipo de ativo (Nomad: bonds e ETF ficam
  // juntos, não bonds em "Renda Fixa" e ETF em "Fundo" — é uma carteira só).
  standalone        Boolean   @default(false)
  // Conexão que o Luiz não usa mais, mas cujo histórico real (posições,
  // transações) não pode ser apagado sem querer — arquivar tira a corretora
  // das telas ativas (Patrimônio, sync automático, botão Sincronizar) sem
  // perder nenhum registro. Reversível a qualquer momento (desarquivar).
  archivedAt        DateTime?

  transactions      Transaction[]
  positionSnapshots PositionSnapshot[]
  contributions     Contribution[]
  dividendPayments  DividendPayment[]
  movements         InvestmentMovement[]
  costEntries       CostEntry[]
}

model Security {
  id                  String  @id @default(uuid())
  name                String
  ticker              String?
  type                String // FII | Ação | Renda Fixa | Cripto | Moeda | Fundo
  sector              String?
  currency            String  @default("BRL") // BRL | USD — Nomad/Phantom são cotados em USD
  targetAllocationPct Float?
  targetDividendYield Float?

  // Detalhe pro popup de hover — a Pluggy manda isso de verdade pra renda
  // fixa (emissor, vencimento, taxa) e pra ação/FII (ISIN, gestora). Fica
  // aqui no Security (não no Snapshot) porque é característica do ativo,
  // não algo que muda mês a mês.
  isin            String?
  issuer          String? // emissor (CDB/debênture) ou gestora (FII)
  dueDate         DateTime? // vencimento — só renda fixa
  fixedAnnualRate Float? // taxa contratada (% a.a.) — só renda fixa
  ratePeriodicity String? // ex: DAILY
  // Indexador (17/11): CDB do Sofisa vem com fixedAnnualRate 0 e a taxa de
  // verdade em `rate` + `rateType` ("105" + "CDI" = 105% do CDI). Tesouro
  // Selic: SELIC + fixedAnnualRate; IPCA+: IPCA + fixedAnnualRate.
  rate            Float?
  rateType        String? // CDI | SELIC | IPCA | null (prefixado)

  positionSnapshots PositionSnapshot[]
  contributions     Contribution[]
  dividendPayments  DividendPayment[]
  movements         InvestmentMovement[]
  costEntries       CostEntry[]
}

// Registro de aporte/resgate lançado à mão (05/09) — histórico auditável de
// "quando entrou/saiu dinheiro de verdade", em vez de inferir isso por
// diferença de snapshot (foi exatamente a raiz dos 2 bugs corrigidos no mesmo
// dia: câmbio da Nomad vazando pro investido, e Ação/FII perdendo a proteção
// contra sync). `investedAmount` do PositionSnapshot continua sendo o valor
// "travado" usado em todo o resto do app — Contribution só é a fonte que
// ALIMENTA esse valor (ver applyContribution em services/contributions.ts),
// nunca é recalculado a partir dele.
model Contribution {
  id          String   @id @default(uuid())
  brokerId    String
  broker      Broker   @relation(fields: [brokerId], references: [id])
  securityId  String
  security    Security @relation(fields: [securityId], references: [id])
  date        DateTime
  amount      Float // valor digitado, na moeda original (currency) — nunca convertido aqui
  currency    String // moeda em que o valor foi digitado (BRL | USD)
  amountBRL   Float // valor já convertido pra BRL no momento do registro — histórico nunca recota
  fxRateToBRL Float? // cotação usada na conversão, se currency != BRL
  note        String?
  createdAt   DateTime @default(now())

  @@index([securityId])
  @@index([brokerId])
}

// Aplicação/resgate REAL de corretora conectada (17/11). Luiz: "hoje o aporte
// é deduzido pela variação do investido entre meses — passe a registrar cada
// aplicação/resgate". Achado real: o BTG recalcula o "valor aplicado" do
// Tesouro sem nenhuma movimentação (nov/26: −R$2.824 de "resgate" que não
// existiu, quantidade igual). Fonte: extrato da posição na Pluggy
// (GET /investments/{id}/transactions, BUY/SELL). `source: "manual"` = lançada
// à mão enquanto a Pluggy não traz — some sozinha quando a da Pluggy chega
// (mesmo ativo, mesmo tipo, valor e data próximos). Aporte do mês de corretora
// conectada = soma daqui; rendimento = valor final − valor inicial − aportes.
model InvestmentMovement {
  id         String   @id @default(uuid())
  brokerId   String
  broker     Broker   @relation(fields: [brokerId], references: [id])
  securityId String
  security   Security @relation(fields: [securityId], references: [id])
  date       DateTime
  kind       String // aplicacao | resgate
  amount     Float // sempre positivo, em BRL
  quantity   Float?
  source     String // pluggy | manual
  externalId String?  @unique // id da transação na Pluggy
  note       String?
  createdAt  DateTime @default(now())

  @@index([brokerId, date])
  @@index([securityId])
}

// Livro de custo de Ação/FII (25/11) — ver services/costLedger.ts. Luiz:
// "Use o preço médio do BTG como base para TODAS as ações e FIIs... o
// investido passa a ser calculado pelas movimentações: soma as compras e
// desconta as vendas pelo custo médio das cotas vendidas. A Pluggy fica
// responsável só por quantidade, preço atual e saldo."
// Só guarda o que NÃO vem do extrato: a base (quantidade × preço médio do
// BTG numa data) e ajustes manuais. Compra/venda vêm de InvestmentMovement.
// Nada é apagado: desfazer = marcar revertedAt (o histórico fica).
model CostEntry {
  id             String    @id @default(uuid())
  brokerId       String
  broker         Broker    @relation(fields: [brokerId], references: [id])
  securityId     String
  security       Security  @relation(fields: [securityId], references: [id])
  date           DateTime // a partir de quando vale (meio-dia UTC do dia no Brasil)
  kind           String // base | ajuste
  quantity       Float? // base: nº de cotas na data
  unitCost       Float? // base: preço médio do BTG
  amount         Float // base: custo total (quantity × unitCost); ajuste: diferença em R$ (+/−)
  source         String // btg_preco_medio | app | mcp | script
  reason         String?
  createdAt      DateTime  @default(now())
  revertedAt     DateTime?
  revertedReason String?

  @@index([securityId, date])
}

model PositionSnapshot {
  id             String    @id @default(uuid())
  brokerId       String
  broker         Broker    @relation(fields: [brokerId], references: [id])
  securityId     String
  security       Security  @relation(fields: [securityId], references: [id])
  month          Int
  year           Int
  investedAmount Float // sempre em BRL — já convertido na gravação se a security for USD
  marketValue    Float // idem
  fxRateToBRL    Float? // cotação USD/BRL usada na conversão daquele mês; null quando currency já é BRL
  // Investido na moeda original (USD/EUR) — corretora manual em moeda
  // estrangeira (Nomad, Wise), 25/11. Antes isso era deduzido como
  // investido em R$ ÷ cotação da foto; com a cotação passando a ser a de
  // fechamento do mês (ver services/foreignFx.ts), a dedução mudaria sozinha
  // e a próxima atualização veria um aporte em dólar que não existiu.
  investedOriginal Float?
  dividends      Float?
  // monthlyRatePct/annualRatePct: a Pluggy tem esses campos no payload, mas
  // vêm sempre null nesse tier de conta pessoal — não é bug, não tem o que
  // capturar. Ficam declarados pra quando/se a conta subir de tier.
  monthlyRatePct Float?
  annualRatePct  Float?
  quantity       Float? // nº de cotas/ações — isso sim a Pluggy manda de verdade
  unitValue      Float? // valor de mercado de 1 cota/ação nesse momento
  // Quando a foto do mês foi tirada pela última vez (17/11). Aplicação feita
  // DEPOIS disso só aparece no valor do mês seguinte — o rendimento do mês
  // não pode descontar um aporte que o valor ainda não mostra.
  syncedAt       DateTime?
  // Mantida da foto anterior (20/11): ação/FII que a corretora parou de mostrar
  // (quantidade zero) sem venda nenhuma no extrato — achado real: DIRR3, GGBR4
  // e VBBR3 alugadas (BTC) sumiram da Pluggy em nov/26. Fica com a última
  // quantidade/custo/valor até voltar ou aparecer a venda; aviso na Saúde dos dados.
  carriedForward Boolean   @default(false)

  @@unique([brokerId, securityId, month, year])
  // Última alteração (25/11, conector MCP: "todo número mostra a origem e a data da última alteração").
  updatedAt DateTime? @updatedAt
}

// Provento (dividendo/JCP/rendimento) por ativo/mês — separado de
// PositionSnapshot de propósito (11/09): dividendo é um FLUXO ligado à DATA
// REAL da transação na Pluggy, não ao mês em que a GENTE já tinha um
// snapshot daquela posição. Achado real: BTG só passou a sincronizar
// Ação/FII por ativo individual (via Pluggy) a partir de agosto/2026 — antes
// disso a carteira inteira vivia agregada num só `PositionSnapshot` manual
// ("MANUAL:BTG:AÇÕES"/"FIIS"), sem granularidade por ticker. Só que a Pluggy
// já tinha o extrato de transações completo desde MUITO antes (ex: HTMX11
// pagando desde set/2025) — sem essa tabela própria, `fetchAndSyncDividends`
// só conseguia fazer `updateMany` num `PositionSnapshot` que já existisse
// pro mês, e pra jan-jul/2026 nenhum existia por ticker, então esses meses
// ficavam pra sempre sem provento nenhum no gráfico "por mês do ano", mesmo
// o dinheiro tendo entrado de verdade. Aqui grava incondicionalmente, sem
// depender de nenhum snapshot existir.
model DividendPayment {
  id         String   @id @default(uuid())
  brokerId   String
  broker     Broker   @relation(fields: [brokerId], references: [id])
  securityId String
  security   Security @relation(fields: [securityId], references: [id])
  month      Int
  year       Int
  amount     Float

  @@unique([brokerId, securityId, month, year])
}

// Meta geral (o "1º milhão" em si) — singleton: valor alvo + quanto o Luiz
// pretende investir por mês. Substituiu (01/09) a antiga WealthGoalYearly
// (tabela ano a ano com "retorno assumido" chutado por ele) — o retorno
// agora vem calculado de verdade a partir do histórico real de
// PositionSnapshot (ver services/wealthProjection.ts), só o aporte mensal
// continua sendo algo só ele sabe (intenção futura, não tem como derivar
// de dado passado).
model WealthGoal {
  id                  String @id @default(uuid())
  targetAmount        Float
  monthlyContribution Float  @default(0)
}

model CategorizationRule {
  id         String   @id @default(uuid())
  pattern    String // trecho da descrição, ex: "uber"
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  confidence Float    @default(0.5)
}

// ---------- Módulo 2: Projetos & Freelance ----------

model Client {
  id        String    @id @default(uuid())
  name      String    @unique
  // Determina o tratamento de imposto do projeto (01/09, confirmado com o
  // Luiz): cliente nacional paga DAS fixo 6% sobre o valor — dá pra mostrar
  // na hora. Cliente estrangeiro tem DAS variável (ele só sabe o valor real
  // quando chega o boleto, ex: 3,4% da última vez) — imposto fica "a
  // definir" até existir um TaxPayment real pro mês de competência, e nesse
  // caso o valor é rateado proporcionalmente entre os projetos daquele mês
  // (nunca um chute, só o valor real do boleto dividido pela participação
  // de cada projeto no faturamento do mês).
  isForeign Boolean   @default(false)
  projects  Project[]
}

model Project {
  id                   String    @id @default(uuid())
  clientId             String
  client               Client    @relation(fields: [clientId], references: [id])
  name                 String
  startDate            DateTime
  endDate              DateTime?
  contractValue        Float // sempre em BRL — é o número que alimenta DAS/receita bruta/"a receber" em todo o resto do sistema, nunca muda de significado
  // Contrato de cliente estrangeiro (07/09): valor real combinado na moeda
  // dele (ex: USD) — só informativo, nunca entra em nenhuma soma agregada
  // (DAS, receita, "a receber" continuam 100% em BRL via contractValue
  // acima). Serve só pra "progresso do contrato" bater exato (USD contra
  // USD), já que contractValue em BRL é só uma estimativa que nunca vai
  // bater com o que realmente chega depois de câmbio + tarifa.
  contractValueForeign Float?
  currency             String? // moeda de contractValueForeign, ex: "USD" — null = projeto 100% BRL
  hasInvoice           Boolean   @default(true)
  installmentCount     Int       @default(1)
  status               String    @default("em_andamento") // em_andamento | pausado | finalizado | cancelado
  // Finalizado À MÃO (06/10, pedido do Luiz: "deixa o botão manual caso o
  // cliente pague a menos ou a mais") — fecha o projeto mesmo sem o
  // recebido bater com o contrato. Null = fecha só pela regra automática
  // (recebido >= contrato, na moeda do contrato). Ver `projectClosure`.
  closedManuallyAt     DateTime?

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  receipts      ProjectReceipt[]
  supplierCosts ProjectSupplierCost[]
  // Última alteração (25/11, conector MCP: "todo número mostra a origem e a data da última alteração").
  updatedAt DateTime? @updatedAt
}

model ProjectReceipt {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  installmentNumber Int      @default(1)
  amount            Float // valor LÍQUIDO em BRL que realmente caiu na conta — digitado do extrato, nunca calculado/estimado. É o que vira Transaction (dashboard, orçamento, DAS etc. leem daqui, sem exceção).
  paymentDate       DateTime

  // Recebimento de contrato em moeda estrangeira (07/09) — mesma lógica do
  // Project acima: só informativo, pra progresso e pra conferir quanto foi
  // tarifa/IOF de verdade (extrato da Wise). `amount` acima continua sendo
  // o dado real que já alimenta o resto do sistema.
  grossAmountForeign Float? // valor bruto recebido, na moeda do contrato
  feeAmount          Float? // tarifa (ex: Wise), na moeda do contrato
  iofAmount          Float? // IOF, na moeda do contrato

  transactions Transaction[]
  // Última alteração (25/11, conector MCP: "todo número mostra a origem e a data da última alteração").
  updatedAt DateTime? @updatedAt
}

model TaxPayment {
  id              String   @id @default(uuid())
  competenceMonth Int
  competenceYear  Int
  totalRevenue    Float
  amountPaid      Float
  paymentDate     DateTime
  // effectiveRate é calculada em runtime: amountPaid / totalRevenue

  transactions Transaction[]

  @@unique([competenceMonth, competenceYear])
}

model Supplier {
  id           String                @id @default(uuid())
  name         String                @unique
  projectCosts ProjectSupplierCost[]
}

model ProjectSupplierCost {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  agreedAmount     Float
  installmentCount Int      @default(1)

  payments SupplierPayment[]
}

model SupplierPayment {
  id                    String              @id @default(uuid())
  projectSupplierCostId String
  projectSupplierCost   ProjectSupplierCost @relation(fields: [projectSupplierCostId], references: [id])
  installmentNumber     Int                 @default(1)
  amount                Float
  paymentDate           DateTime

  transactions Transaction[]
}

// ---------- Módulo 3: Acesso (login do app, uso pessoal) ----------

// Trava de acesso do app inteiro — uso pessoal, um usuário só, sem sistema de
// contas/cadastro. Singleton (igual WealthGoal): guarda só o hash da senha
// de 6 dígitos (nunca a senha em texto puro). Criada no primeiro acesso
// (POST /auth/setup), trocável depois em Configurações.
model AppAuth {
  id      String @id @default(uuid())
  pinHash String
}

// Credencial Face ID/Touch ID (WebAuthn) cadastrada por aparelho — atalho
// pra não digitar a senha de 6 dígitos toda vez; a senha continua sendo o
// mecanismo real (sempre disponível como alternativa). `id` é o credential
// ID que o próprio navegador gera (base64url), não é gerado por nós.
model WebauthnCredential {
  id          String   @id
  publicKey   Bytes
  counter     Int      @default(0)
  transports  String? // JSON array (ex: ["internal"])
  deviceLabel String // ex: "iPhone do Luiz" — escolhido no cadastro
  createdAt   DateTime @default(now())
}

// Último câmbio USD/BRL que a AwesomeAPI (gratuita, sem chave, sem SLA)
// realmente devolveu — achado real (08/09): o IP do droplet levou 429 dela
// (provavelmente rate-limit por IP compartilhado com os outros apps do
// mesmo servidor) bem no meio de um "Registrar aporte" em dólar, travando a
// ação inteira. `services/fx.ts` grava aqui toda vez que a API responde de
// verdade, e cai pra esse valor (mesmo que com algumas horas de atraso) só
// quando a chamada ao vivo falha — nunca quando ela funciona. Câmbio não
// pula o suficiente numa janela de poucas horas pra isso distorcer o valor
// investido de um jeito que importe.
model FxRateCache {
  pair      String   @id // "USD-BRL"; fechamento do mês: "USD-BRL@2026-10"
  rate      Float
  fetchedAt DateTime // fechamento: o DIA da cotação (meio-dia UTC)
  source    String? // fechamento (25/11): "ptax_venda" | "awesomeapi" | "manual"
}

// ---------- Conector do Claude (MCP) — login OAuth 2.1 (16/10) ----------
// Pedido do Luiz: "quero falar com o Claude no iPhone e ele ver minhas
// informações no Command OS". Mesmo desenho do conector do toDo: registro
// dinâmico de cliente (só apps do Claude), código com PKCE S256, refresh
// token rotativo. Consentimento = a senha de 6 dígitos do app. Token só
// guardado como hash SHA-256. O conector é SÓ LEITURA.
model OAuthClient {
  clientId     String       @id
  secretHash   String?
  name         String
  redirectUris String // JSON array
  createdAt    DateTime     @default(now())
  tokens       OAuthToken[]
}

model OAuthCode {
  codeHash    String   @id
  clientId    String
  redirectUri String
  challenge   String
  scope       String?
  resource    String?
  expiresAt   DateTime
}

model OAuthToken {
  tokenHash String      @id
  kind      String // access | refresh
  clientId  String
  client    OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  scope     String?
  resource  String?
  expiresAt DateTime
  createdAt DateTime    @default(now())
}

// Aviso da "Saúde dos dados" que o Luiz marcou como "é assim mesmo" (27/10)
// — ex.: dois cafés iguais no mesmo dia. A chave identifica o item exato
// (regra + o que foi apontado), então o aviso some só pra aquele caso.
model DataHealthIgnore {
  key       String   @id
  createdAt DateTime @default(now())
}

// Compra parcelada (05/11) — UMA linha por compra, com a categoria e a nota
// que valem pra TODAS as parcelas dela, as já lançadas (Transaction) e as que
// ainda vêm (UpcomingInstallment). Antes a categoria morava em cada linha e se
// perdia quando a parcela prevista virava lançamento (sync de 04/11: 18
// parcelas "sem categoria"). Categorizar qualquer parcela = categorizar a
// compra (services/purchases.ts). id: "p:<código>" (Pluggy, mesmo código de
// `pluggy:p:<código>:<n>`) ou "m:<código>" (parcela digitada, cartão Caixa).
model Purchase {
  id                String    @id
  cardLabel         String?
  description       String
  installmentAmount Float
  totalInstallments Int?
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  transactions Transaction[]
  installments UpcomingInstallment[]
}

// Total de gasto de cada mês já fechado (05/11) — "número de mês fechado não
// muda". Gravado no dia 10 do mês seguinte (tempo das últimas compras do mês
// chegarem); a Saúde dos dados avisa se o total mudar depois disso.
model MonthTotal {
  ym         String   @id // "2026-09"
  total      Float
  byCategory String // JSON { categoryId|"uncategorized": total }
  recordedAt DateTime @default(now())
}

// Histórico de sincronização (25/11, conector MCP: `historico_sync`). Uma
// linha por execução: cartão/conta, investimentos, on-chain ou câmbio, por
// corretora, com quem disparou (agendador, botão, webhook) e o resultado.
model SyncRun {
  id         String   @id @default(uuid())
  kind       String // cartao | investimentos | onchain | cambio
  brokerName String?
  trigger    String // agendador | botao | webhook:<evento> | script
  startedAt  DateTime
  finishedAt DateTime
  ok         Boolean
  summary    String?
  error      String?

  @@index([startedAt])
}
