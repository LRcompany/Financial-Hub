// Schema inicial — mapeado a partir de docs/blueprint.md
// SQLite não suporta enum nativo no Prisma, então campos que seriam enum
// viram String com o conjunto de valores válidos documentado no comentário.
// Validação desses valores fica na camada de aplicação (ex: Zod), não no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Módulo 1: Financeiro Pessoal ----------

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  type        String // income | expense
  description String
  amount      Float
  source      String   @default("manual") // manual | pluggy | ofx_import
  externalId  String?  @unique // id da transação na Pluggy/OFX, evita duplicar import (upsert)
  isTransfer  Boolean  @default(false) // true = não conta como gasto/receita real
  // true = a Pluggy reportou como "PENDING" (comum em compra internacional —
  // entra com descrição genérica tipo "MASTERCARD INTERNACIONAL" antes do
  // banco confirmar o lojista real). Enquanto true, o próximo sync confere
  // se já virou "POSTED" e atualiza descrição/valor/categoria pro dado real
  // — sem isso, uma transação pendente ficava presa com o nome genérico pra
  // sempre (nosso sync nunca revisita uma já sincronizada). Nunca mexe numa
  // transação já `false` (poderia sobrescrever categoria corrigida à mão).
  pluggyPending Boolean @default(false)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id])

  taxPaymentId String?
  taxPayment   TaxPayment? @relation(fields: [taxPaymentId], references: [id])

  projectReceiptId String?
  projectReceipt   ProjectReceipt? @relation(fields: [projectReceiptId], references: [id])

  supplierPaymentId String?
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])

  loanReceivableId String?
  loanReceivable   LoanReceivable? @relation(fields: [loanReceivableId], references: [id])

  createdAt DateTime @default(now())

  @@index([date])
  @@index([categoryId])
}

// Parcela de compra parcelada que ainda vai vencer — não é Transaction (não
// aconteceu de fato ainda, "nada de valor fake"), mas é informação real
// (vem do próprio livro-razão dele, que já projeta parcela futura). Serve
// pra responder "quanto ainda tenho comprometido no cartão".
model UpcomingInstallment {
  id          String   @id @default(uuid())
  dueDate     DateTime
  description String
  // Nome real do comerciante geralmente vem ilegível da fatura (ex:
  // "AMAZONMKTPLC HEIMONLTD") — `note` é o detalhe que o Luiz mesmo escreve
  // ("fone de ouvido bluetooth") pra lembrar o que a compra foi de verdade.
  // Nunca sobrescreve `description` (que continua batendo com a fatura real).
  note        String?
  amount      Float
  // Qual cartão/fatura essa parcela pertence (ex: "Caixa 5709", "C6", "BTG")
  // — null pra parcela que veio da planilha sem essa informação (não dava
  // pra saber o cartão só pelo livro-razão). Permite sintetizar "quanto
  // ainda falta em cada cartão", não só o total geral.
  cardLabel   String?
  // "pluggy:<id da transação>:<parcela N>" pra parcela que veio do sync real
  // da Pluggy — evita recriar a mesma parcela futura toda vez que o sync
  // roda de novo. Null pra parcela importada da planilha (sem esse conceito).
  externalId String? @unique
  // Total de parcelas da compra (ex: 10 numa compra parcelada em 10x) —
  // override MANUAL (Luiz corrige na modal "Revisar parcelas"). Pra parcela
  // vinda do sync real da Pluggy, dá pra DERIVAR isso sem esse campo (maior
  // N visto no externalId "pluggy:<txId>:<N>" entre as parcelas da mesma
  // compra), então esse campo normalmente fica null e o cálculo automático
  // já resolve. Só é preenchido quando o automático erra ou quando a parcela
  // é da planilha antiga (sem externalId, sem como derivar nada sozinho).
  totalInstallments Int?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([dueDate])
}

model Recurrence {
  id           String    @id @default(uuid())
  frequency    String    @default("monthly") // monthly (único usado hoje)
  installments Int? // número fixo de parcelas, null = recorrente sem fim
  startDate    DateTime

  transactions Transaction[]
  projects     Project[]
}

model Category {
  id       String  @id @default(uuid())
  name     String
  type     String // income | expense
  // Só relevante pra expense — 3 estados reais (não dava pra fazer isso com
  // um booleano "essential" só): essential | non_essential | investment.
  // "investment" é a seção separada da planilha do Luiz (Reserva de
  // Emergência, Nomad, Ações...) — não é "gasto" no sentido normal, então
  // nunca deveria ter ficado misturada com Streaming/Cinema em "não
  // essencial" (era exatamente isso que a coluna essential=false fazia).
  kind     String  @default("non_essential")

  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  transactions   Transaction[]
  budgetTargets  BudgetTarget[]
  categorizationRules CategorizationRule[]
  upcomingInstallments UpcomingInstallment[]

  @@unique([name, parentId])
}

model BudgetTarget {
  id            String   @id @default(uuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  month         Int
  year          Int
  plannedAmount Float

  @@unique([categoryId, month, year])
}

// Append-only: cada mudança cria uma linha nova, nunca sobrescreve a
// anterior — "qual era a meta vigente no dia X" é sempre uma consulta
// (maior effectiveFrom <= X), nunca um valor único perdido no tempo.
model DailySpendGoal {
  id            String   @id @default(uuid())
  amount        Float
  effectiveFrom DateTime
}

model Debt {
  id                String            @id @default(uuid())
  creditor          String
  installmentAmount Float
  installmentCount  Int
  startDate         DateTime
  installments      DebtInstallment[]
}

model DebtInstallment {
  id         String   @id @default(uuid())
  debtId     String
  debt       Debt     @relation(fields: [debtId], references: [id])
  dueDate    DateTime
  paid       Boolean  @default(false)
  paidAmount Float?
}

model LoanReceivable {
  id              String                    @id @default(uuid())
  borrower        String
  principalAmount Float
  loanDate        DateTime
  repayments      LoanReceivableRepayment[]
  transactions    Transaction[]
}

model LoanReceivableRepayment {
  id               String         @id @default(uuid())
  loanReceivableId String
  loanReceivable   LoanReceivable @relation(fields: [loanReceivableId], references: [id])
  amount           Float
  paymentDate      DateTime
}

model Broker {
  id                String   @id @default(uuid())
  name              String   @unique // BTG, C6, Caixa, 99, Phantom, Nomad, Mercado Pago, Sofisa, Wise, INCO
  scope             String // JSON array: ["transactions","credit_card","investments"]
  dataSource        String // pluggy | manual_statement | onchain_query
  pluggyConnectorId String?
  onchainAddress    String?
  // Rede da carteira on-chain (dataSource = "onchain_query"): solana | bitcoin
  // | ethereum | base. Endereço EVM (ethereum/base) é o mesmo formato pras
  // duas redes, mas saldo/token são consultados em cada rede separadamente
  // — por isso é 1 Broker por rede, mesmo repetindo o onchainAddress.
  chain             String?
  lastSyncedAt      DateTime?
  // true pra corretora que deve virar sua própria box em Patrimônio, em vez
  // de espalhar as posições por tipo de ativo (Nomad: bonds e ETF ficam
  // juntos, não bonds em "Renda Fixa" e ETF em "Fundo" — é uma carteira só).
  standalone        Boolean  @default(false)
  // Conexão que o Luiz não usa mais, mas cujo histórico real (posições,
  // transações) não pode ser apagado sem querer — arquivar tira a corretora
  // das telas ativas (Patrimônio, sync automático, botão Sincronizar) sem
  // perder nenhum registro. Reversível a qualquer momento (desarquivar).
  archivedAt        DateTime?

  transactions     Transaction[]
  positionSnapshots PositionSnapshot[]
}

model Security {
  id                   String   @id @default(uuid())
  name                 String
  ticker               String?
  type                 String // FII | Ação | Renda Fixa | Cripto | Moeda | Fundo
  sector               String?
  currency             String   @default("BRL") // BRL | USD — Nomad/Phantom são cotados em USD
  targetAllocationPct  Float?
  targetDividendYield  Float?

  // Detalhe pro popup de hover — a Pluggy manda isso de verdade pra renda
  // fixa (emissor, vencimento, taxa) e pra ação/FII (ISIN, gestora). Fica
  // aqui no Security (não no Snapshot) porque é característica do ativo,
  // não algo que muda mês a mês.
  isin            String?
  issuer          String? // emissor (CDB/debênture) ou gestora (FII)
  dueDate         DateTime? // vencimento — só renda fixa
  fixedAnnualRate Float? // taxa contratada (% a.a.) — só renda fixa
  ratePeriodicity String? // ex: DAILY

  positionSnapshots PositionSnapshot[]
}

model PositionSnapshot {
  id             String   @id @default(uuid())
  brokerId       String
  broker         Broker   @relation(fields: [brokerId], references: [id])
  securityId     String
  security       Security @relation(fields: [securityId], references: [id])
  month          Int
  year           Int
  investedAmount Float // sempre em BRL — já convertido na gravação se a security for USD
  marketValue    Float // idem
  fxRateToBRL    Float? // cotação USD/BRL usada na conversão daquele mês; null quando currency já é BRL
  dividends      Float?
  // monthlyRatePct/annualRatePct: a Pluggy tem esses campos no payload, mas
  // vêm sempre null nesse tier de conta pessoal — não é bug, não tem o que
  // capturar. Ficam declarados pra quando/se a conta subir de tier.
  monthlyRatePct Float?
  annualRatePct  Float?
  quantity       Float? // nº de cotas/ações — isso sim a Pluggy manda de verdade
  unitValue      Float? // valor de mercado de 1 cota/ação nesse momento

  @@unique([brokerId, securityId, month, year])
}

// Meta geral (o "1º milhão" em si) — singleton: valor alvo + quanto o Luiz
// pretende investir por mês. Substituiu (01/09) a antiga WealthGoalYearly
// (tabela ano a ano com "retorno assumido" chutado por ele) — o retorno
// agora vem calculado de verdade a partir do histórico real de
// PositionSnapshot (ver services/wealthProjection.ts), só o aporte mensal
// continua sendo algo só ele sabe (intenção futura, não tem como derivar
// de dado passado).
model WealthGoal {
  id                 String @id @default(uuid())
  targetAmount       Float
  monthlyContribution Float @default(0)
}

model CategorizationRule {
  id         String   @id @default(uuid())
  pattern    String // trecho da descrição, ex: "uber"
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  confidence Float    @default(0.5)
}

// ---------- Módulo 2: Projetos & Freelance ----------

model Client {
  id       String    @id @default(uuid())
  name     String    @unique
  // Determina o tratamento de imposto do projeto (01/09, confirmado com o
  // Luiz): cliente nacional paga DAS fixo 6% sobre o valor — dá pra mostrar
  // na hora. Cliente estrangeiro tem DAS variável (ele só sabe o valor real
  // quando chega o boleto, ex: 3,4% da última vez) — imposto fica "a
  // definir" até existir um TaxPayment real pro mês de competência, e nesse
  // caso o valor é rateado proporcionalmente entre os projetos daquele mês
  // (nunca um chute, só o valor real do boleto dividido pela participação
  // de cada projeto no faturamento do mês).
  isForeign Boolean   @default(false)
  projects Project[]
}

model Project {
  id               String    @id @default(uuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  name             String
  startDate        DateTime
  endDate          DateTime?
  contractValue    Float
  hasInvoice       Boolean   @default(true)
  installmentCount Int       @default(1)
  status           String    @default("em_andamento") // em_andamento | pausado | finalizado | cancelado

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  receipts       ProjectReceipt[]
  supplierCosts  ProjectSupplierCost[]
}

model ProjectReceipt {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  installmentNumber Int      @default(1)
  amount            Float // valor cheio, sem desconto
  paymentDate       DateTime

  transactions Transaction[]
}

model TaxPayment {
  id               String   @id @default(uuid())
  competenceMonth  Int
  competenceYear   Int
  totalRevenue     Float
  amountPaid       Float
  paymentDate      DateTime
  // effectiveRate é calculada em runtime: amountPaid / totalRevenue

  transactions Transaction[]

  @@unique([competenceMonth, competenceYear])
}

model Supplier {
  id                String                @id @default(uuid())
  name              String                @unique
  projectCosts      ProjectSupplierCost[]
}

model ProjectSupplierCost {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  agreedAmount     Float
  installmentCount Int      @default(1)

  payments SupplierPayment[]
}

model SupplierPayment {
  id                     String              @id @default(uuid())
  projectSupplierCostId  String
  projectSupplierCost    ProjectSupplierCost @relation(fields: [projectSupplierCostId], references: [id])
  installmentNumber      Int                 @default(1)
  amount                 Float
  paymentDate            DateTime

  transactions Transaction[]
}

// ---------- Módulo 3: Acesso (login do app, uso pessoal) ----------

// Trava de acesso do app inteiro — uso pessoal, um usuário só, sem sistema de
// contas/cadastro. Singleton (igual WealthGoal): guarda só o hash da senha
// de 6 dígitos (nunca a senha em texto puro). Criada no primeiro acesso
// (POST /auth/setup), trocável depois em Configurações.
model AppAuth {
  id      String @id @default(uuid())
  pinHash String
}

// Credencial Face ID/Touch ID (WebAuthn) cadastrada por aparelho — atalho
// pra não digitar a senha de 6 dígitos toda vez; a senha continua sendo o
// mecanismo real (sempre disponível como alternativa). `id` é o credential
// ID que o próprio navegador gera (base64url), não é gerado por nós.
model WebauthnCredential {
  id          String   @id
  publicKey   Bytes
  counter     Int      @default(0)
  transports  String? // JSON array (ex: ["internal"])
  deviceLabel String // ex: "iPhone do Luiz" — escolhido no cadastro
  createdAt   DateTime @default(now())
}
