// Schema inicial — mapeado a partir de docs/blueprint.md
// SQLite não suporta enum nativo no Prisma, então campos que seriam enum
// viram String com o conjunto de valores válidos documentado no comentário.
// Validação desses valores fica na camada de aplicação (ex: Zod), não no banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Módulo 1: Financeiro Pessoal ----------

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  type        String // income | expense
  description String
  amount      Float
  source      String   @default("manual") // manual | pluggy | ofx_import
  externalId  String? // id da transação na Pluggy/OFX, evita duplicar import
  isTransfer  Boolean  @default(false) // true = não conta como gasto/receita real

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  brokerId String?
  broker   Broker? @relation(fields: [brokerId], references: [id])

  taxPaymentId String?
  taxPayment   TaxPayment? @relation(fields: [taxPaymentId], references: [id])

  projectReceiptId String?
  projectReceipt   ProjectReceipt? @relation(fields: [projectReceiptId], references: [id])

  supplierPaymentId String?
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])

  loanReceivableId String?
  loanReceivable   LoanReceivable? @relation(fields: [loanReceivableId], references: [id])

  createdAt DateTime @default(now())

  @@index([date])
  @@index([categoryId])
}

// Parcela de compra parcelada que ainda vai vencer — não é Transaction (não
// aconteceu de fato ainda, "nada de valor fake"), mas é informação real
// (vem do próprio livro-razão dele, que já projeta parcela futura). Serve
// pra responder "quanto ainda tenho comprometido no cartão".
model UpcomingInstallment {
  id          String   @id @default(uuid())
  dueDate     DateTime
  description String
  amount      Float

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())

  @@index([dueDate])
}

model Recurrence {
  id           String    @id @default(uuid())
  frequency    String    @default("monthly") // monthly (único usado hoje)
  installments Int? // número fixo de parcelas, null = recorrente sem fim
  startDate    DateTime

  transactions Transaction[]
  projects     Project[]
}

model Category {
  id       String  @id @default(uuid())
  name     String
  type     String // income | expense
  // Só relevante pra expense — 3 estados reais (não dava pra fazer isso com
  // um booleano "essential" só): essential | non_essential | investment.
  // "investment" é a seção separada da planilha do Luiz (Reserva de
  // Emergência, Nomad, Ações...) — não é "gasto" no sentido normal, então
  // nunca deveria ter ficado misturada com Streaming/Cinema em "não
  // essencial" (era exatamente isso que a coluna essential=false fazia).
  kind     String  @default("non_essential")
  usage    String? // pessoal | trabalho

  parentId String?
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToSubcategory")

  transactions   Transaction[]
  budgetTargets  BudgetTarget[]
  categorizationRules CategorizationRule[]
  upcomingInstallments UpcomingInstallment[]

  @@unique([name, parentId])
}

model BudgetTarget {
  id            String   @id @default(uuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  month         Int
  year          Int
  plannedAmount Float

  @@unique([categoryId, month, year])
}

// Append-only: cada mudança cria uma linha nova, nunca sobrescreve a
// anterior — "qual era a meta vigente no dia X" é sempre uma consulta
// (maior effectiveFrom <= X), nunca um valor único perdido no tempo.
model DailySpendGoal {
  id            String   @id @default(uuid())
  amount        Float
  effectiveFrom DateTime
}

model Debt {
  id                String            @id @default(uuid())
  creditor          String
  installmentAmount Float
  installmentCount  Int
  startDate         DateTime
  installments      DebtInstallment[]
}

model DebtInstallment {
  id         String   @id @default(uuid())
  debtId     String
  debt       Debt     @relation(fields: [debtId], references: [id])
  dueDate    DateTime
  paid       Boolean  @default(false)
  paidAmount Float?
}

model LoanReceivable {
  id              String                    @id @default(uuid())
  borrower        String
  principalAmount Float
  loanDate        DateTime
  repayments      LoanReceivableRepayment[]
  transactions    Transaction[]
}

model LoanReceivableRepayment {
  id               String         @id @default(uuid())
  loanReceivableId String
  loanReceivable   LoanReceivable @relation(fields: [loanReceivableId], references: [id])
  amount           Float
  paymentDate      DateTime
}

model Broker {
  id                String   @id @default(uuid())
  name              String   @unique // BTG, C6, Caixa, 99, Phantom, Nomad, Mercado Pago, Sofisa, Wise, INCO
  scope             String // JSON array: ["transactions","credit_card","investments"]
  dataSource        String // pluggy | manual_statement | onchain_query
  pluggyConnectorId String?
  onchainAddress    String?
  // Rede da carteira on-chain (dataSource = "onchain_query"): solana | bitcoin
  // | ethereum | base. Endereço EVM (ethereum/base) é o mesmo formato pras
  // duas redes, mas saldo/token são consultados em cada rede separadamente
  // — por isso é 1 Broker por rede, mesmo repetindo o onchainAddress.
  chain             String?
  lastSyncedAt      DateTime?
  // true pra corretora que deve virar sua própria box em Patrimônio, em vez
  // de espalhar as posições por tipo de ativo (Nomad: bonds e ETF ficam
  // juntos, não bonds em "Renda Fixa" e ETF em "Fundo" — é uma carteira só).
  standalone        Boolean  @default(false)

  transactions     Transaction[]
  positionSnapshots PositionSnapshot[]
}

model Security {
  id                   String   @id @default(uuid())
  name                 String
  ticker               String?
  type                 String // FII | Ação | Renda Fixa | Cripto | Moeda | Fundo
  sector               String?
  currency             String   @default("BRL") // BRL | USD — Nomad/Phantom são cotados em USD
  targetAllocationPct  Float?
  targetDividendYield  Float?

  // Detalhe pro popup de hover — a Pluggy manda isso de verdade pra renda
  // fixa (emissor, vencimento, taxa) e pra ação/FII (ISIN, gestora). Fica
  // aqui no Security (não no Snapshot) porque é característica do ativo,
  // não algo que muda mês a mês.
  isin            String?
  issuer          String? // emissor (CDB/debênture) ou gestora (FII)
  dueDate         DateTime? // vencimento — só renda fixa
  fixedAnnualRate Float? // taxa contratada (% a.a.) — só renda fixa
  ratePeriodicity String? // ex: DAILY

  positionSnapshots PositionSnapshot[]
}

model PositionSnapshot {
  id             String   @id @default(uuid())
  brokerId       String
  broker         Broker   @relation(fields: [brokerId], references: [id])
  securityId     String
  security       Security @relation(fields: [securityId], references: [id])
  month          Int
  year           Int
  investedAmount Float // sempre em BRL — já convertido na gravação se a security for USD
  marketValue    Float // idem
  fxRateToBRL    Float? // cotação USD/BRL usada na conversão daquele mês; null quando currency já é BRL
  dividends      Float?
  // monthlyRatePct/annualRatePct: a Pluggy tem esses campos no payload, mas
  // vêm sempre null nesse tier de conta pessoal — não é bug, não tem o que
  // capturar. Ficam declarados pra quando/se a conta subir de tier.
  monthlyRatePct Float?
  annualRatePct  Float?
  quantity       Float? // nº de cotas/ações — isso sim a Pluggy manda de verdade
  unitValue      Float? // valor de mercado de 1 cota/ação nesse momento

  @@unique([brokerId, securityId, month, year])
}

// Meta geral (o "1º milhão" em si) — singleton, só o valor alvo.
model WealthGoal {
  id           String @id @default(uuid())
  targetAmount Float
}

// Meta ano a ano — espelha a aba "Primeira Milha(o)" da planilha: cada ano
// tem seu próprio aporte planejado e retorno assumido (em vez de uma taxa
// única valendo pra sempre). Ano sem linha aqui usa a última configurada
// (extrapolação, sinalizada na resposta da API).
model WealthGoalYearly {
  id                        String @id @default(uuid())
  year                      Int    @unique
  savingsTarget             Float // quanto planeja guardar/aportar no ano
  annualReturnAssumptionPct Float
}

model CategorizationRule {
  id         String   @id @default(uuid())
  pattern    String // trecho da descrição, ex: "uber"
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  confidence Float    @default(0.5)
}

// ---------- Módulo 2: Projetos & Freelance ----------

model Client {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

model Project {
  id               String    @id @default(uuid())
  clientId         String
  client           Client    @relation(fields: [clientId], references: [id])
  name             String
  startDate        DateTime
  endDate          DateTime?
  contractValue    Float
  hasInvoice       Boolean   @default(true)
  installmentCount Int       @default(1)
  status           String    @default("em_andamento") // em_andamento | pausado | finalizado | cancelado

  recurrenceId String?
  recurrence   Recurrence? @relation(fields: [recurrenceId], references: [id])

  receipts       ProjectReceipt[]
  supplierCosts  ProjectSupplierCost[]
}

model ProjectReceipt {
  id                String   @id @default(uuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id])
  installmentNumber Int      @default(1)
  amount            Float // valor cheio, sem desconto
  paymentDate       DateTime

  transactions Transaction[]
}

model TaxPayment {
  id               String   @id @default(uuid())
  competenceMonth  Int
  competenceYear   Int
  totalRevenue     Float
  amountPaid       Float
  paymentDate      DateTime
  // effectiveRate é calculada em runtime: amountPaid / totalRevenue

  transactions Transaction[]

  @@unique([competenceMonth, competenceYear])
}

model Supplier {
  id                String                @id @default(uuid())
  name              String                @unique
  projectCosts      ProjectSupplierCost[]
}

model ProjectSupplierCost {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id])
  agreedAmount     Float
  installmentCount Int      @default(1)

  payments SupplierPayment[]
}

model SupplierPayment {
  id                     String              @id @default(uuid())
  projectSupplierCostId  String
  projectSupplierCost    ProjectSupplierCost @relation(fields: [projectSupplierCostId], references: [id])
  installmentNumber      Int                 @default(1)
  amount                 Float
  paymentDate            DateTime

  transactions Transaction[]
}
