# Copie este arquivo para .env e preencha. Nunca commitar o .env real.

# Banco de dados (SQLite local)
DATABASE_URL="file:./dev.db"

# Pluggy (Open Finance) — pegue em dashboard.pluggy.ai, plano pessoal gratuito
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""

# Porta do servidor
PORT=3333

# URL do frontend em dev (pra liberar CORS) — muda se usar outra porta
FRONTEND_URL=http://localhost:5173

# Sessão do login (senha de 6 dígitos + Face ID/Touch ID) — gere uma string
# aleatória longa, ex: openssl rand -hex 32. Trocar esse valor derruba todo
# mundo que já estava logado (o token de sessão para de bater).
SESSION_SECRET=""

# URL completa (com protocolo) que o navegador usa pra abrir o app — em
# produção é o domínio real com https:// (ex: https://financeiro.seudominio.com),
# em dev local é http://localhost:5173. Usado pro cookie de sessão (só manda
# `secure` quando é https://) e pro Face ID/Touch ID (WebAuthn exige HTTPS
# de verdade — em http:// o cadastro/login por Face ID simplesmente não
# funciona, mas a senha de 6 dígitos continua funcionando normalmente).
APP_ORIGIN=http://localhost:5173
